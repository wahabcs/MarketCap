# Live prices, search, company data and news. Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# Price history for charts. Free key: https://twelvedata.com
TWELVEDATA_API_KEY=

# Supabase (Project Settings > API). The publishable key is safe in the browser;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
